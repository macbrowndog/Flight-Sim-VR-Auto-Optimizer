<Window x:Class="SimVROptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:core="clr-namespace:SimVROptimizer.Core;assembly=SimVROptimizer.Core"
        Title="VR Auto-Optimizer — Flight Deck" Width="1160" Height="820" MinWidth="920" MinHeight="700"
        Icon="Assets/AppIcon.ico" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelFrame}" Padding="14,8" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FLIGHT DECK / VR AUTO-OPTIMIZER" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SESSION CONTROL • PERFORMANCE MANAGEMENT • AUTOMATIC RECOVERY" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="HeaderVersionLabel" Grid.Column="2" Text="ANDREW BROWN © 2026 • VERSION" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CyanBrush}" Margin="18,0,0,0" />
                        <Button x:Name="CheckUpdateButton" Grid.Column="3" Content="CHECK UPDATE" Click="CheckUpdateButton_Click"
                                FontSize="10" Padding="9,3" Margin="12,-3,0,-3" Background="#233137" Foreground="{StaticResource AccentBrush}"
                                ToolTip="Checks the official GitHub release. Verified installer updates can be downloaded in-app only after SHA-256 validation." />
                    </Grid>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0A1012" Padding="14,8" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM READY" Style="{StaticResource InstrumentLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="ACCESS LEVEL" Style="{StaticResource InstrumentLabel}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="AdminLabel" Text="STANDARD USER" Style="{StaticResource ReadoutText}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Padding="10" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Width="160" VerticalAlignment="Center">
                    <TextBlock Text="SIMULATOR SELECT" Style="{StaticResource InstrumentLabel}" />
                    <TextBlock Text="NAV / FLIGHT SOURCE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <ComboBox x:Name="SimulatorCombo" Grid.Column="1" Height="38" Margin="12,0" SelectionChanged="SimulatorCombo_SelectionChanged">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="OnlineGuidanceCheck" Grid.Column="2" Content="ONLINE GUIDANCE / opt-in" Margin="8,0,14,0" VerticalAlignment="Center"
                          Checked="OnlineGuidanceCheck_Changed" Unchecked="OnlineGuidanceCheck_Changed"
                          ToolTip="Downloads a curated application and service guidance catalogue, then rescans this PC. No process names, service names, file paths, or PC details are uploaded." />
                <Button x:Name="ScanButton" Grid.Column="3" Content="SCAN THIS PC" Click="ScanButton_Click" Background="#233137" Foreground="{StaticResource AccentBrush}" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Background="#090E10" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="SIMULATORS">
                <DockPanel>
                <StackPanel x:Name="SimulatorManagementPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" IsEnabled="False">
                    <Button Content="ADD" Click="AddSimulator_Click" Padding="12,5" Background="#233137" Foreground="{StaticResource GreenBrush}" />
                    <Button x:Name="EditSimulatorButton" Content="EDIT" Click="EditSimulator_Click" Padding="12,5" Background="#233137" Foreground="{StaticResource AccentBrush}" IsEnabled="False" />
                    <Button x:Name="RemoveSimulatorButton" Content="REMOVE" Click="RemoveSimulator_Click" Padding="12,5" Background="#233137" Foreground="{StaticResource RedBrush}" IsEnabled="False" />
                </StackPanel>
                <DataGrid x:Name="SimulatorGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0C1214" Foreground="{StaticResource TextBrush}"
                          SelectionMode="Single" SelectionChanged="SimulatorGrid_SelectionChanged"
                          RowBackground="#0C1214" AlternatingRowBackground="#111A1D" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SIMULATOR" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="DETECTION SOURCE" Binding="{Binding Detection}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="APPLICATIONS">
                <Grid Background="#0C1214">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#151D20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="APP LOAD CONTROL  /  RECOMMEND = safe to close  ·  KEEP RUNNING = review first  ·  PROTECTED = locked" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Content="INVERT SELECTION" Click="InvertApplicationsButton_Click" Padding="12,4" ToolTip="Reverse the checked state of selectable applications. Protected and required applications remain unchanged." />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="AppsGrid" Grid.Row="1" AutoGenerateColumns="False" Background="#0C1214" Foreground="{StaticResource TextBrush}"
                              RowBackground="#0C1214" AlternatingRowBackground="#111A1D" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUT" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeSelection}" Click="CandidateSelection_Click" HorizontalAlignment="Center" ToolTip="Process Lasso power controllers are locked selected on AMD X3D so Windows Balanced can remain active." /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="APPLICATION" Binding="{Binding DisplayName}" Width="1.4*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="IDENTITY" Width="105" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding IdentityLabel}" FontFamily="Consolas" Foreground="{StaticResource CyanBrush}">
                                        <TextBlock.ToolTip><ToolTip MaxWidth="540"><TextBlock Text="{Binding IdentityDetails}" TextWrapping="Wrap" MaxWidth="520" /></ToolTip></TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="GUIDANCE" Width="112" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassificationLabel}" FontFamily="Consolas" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Recommended"><Setter Property="Foreground" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Optional"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Protected"><Setter Property="Foreground" Value="{StaticResource CyanBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="IMPACT" Binding="{Binding ImpactLabel}" Width="75" IsReadOnly="True" />
                            <DataGridTextColumn Header="CPU NOW" Binding="{Binding CpuPercentLabel}" Width="78" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEM MB" Binding="{Binding MemoryMb}" Width="78" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="AFTER FLIGHT" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AfterFlightChoices}"
                                                  SelectedItem="{Binding SelectedAfterFlightChoice, Mode=OneWay}"
                                                  IsEnabled="{Binding CanChangeAfterFlight}"
                                                  SelectionChanged="AfterFlightSelection_Changed"
                                                  Height="25" Padding="5,2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RESTART SAFETY" Width="145" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RestartSafetyLabel}" FontFamily="Consolas" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRestartAfterFlight}" Value="True"><Setter Property="Foreground" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.ToolTip><ToolTip MaxWidth="480"><TextBlock Text="{Binding RestartSafetyDetail}" TextWrapping="Wrap" MaxWidth="460" /></ToolTip></TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="TEST" Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="TEST" Click="TestRestartButton_Click" IsEnabled="{Binding CanTestRestart}"
                                                Padding="6,2" Margin="2" Background="#233137" Foreground="{StaticResource CyanBrush}"
                                                ToolTip="Closes and immediately relaunches this application to verify its restart command." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="WHY THIS GUIDANCE" Width="2.2*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassificationReason}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="520">
                                                    <TextBlock Text="{Binding ClassificationReason}" TextWrapping="Wrap" MaxWidth="500" />
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="MSFS IMPACT NOTE" Width="2.8*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="520">
                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" MaxWidth="500" />
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="SERVICES">
                <Grid Background="#0C1214">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#151D20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="SERVICE LOAD CONTROL  /  RECOMMEND = safe default  ·  KEEP RUNNING = review first  ·  PROTECTED = locked  ·  AFTER FLIGHT = always restored" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Border>
                    <DataGrid x:Name="ServicesGrid" Grid.Row="1" AutoGenerateColumns="False" Background="#0C1214" Foreground="{StaticResource TextBrush}"
                              RowBackground="#0C1214" AlternatingRowBackground="#111A1D" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUT" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStop}" Click="CandidateSelection_Click" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="SERVICE" Binding="{Binding DisplayName}" Width="1.4*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="IDENTITY" Width="105" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding IdentityLabel}" FontFamily="Consolas" Foreground="{StaticResource CyanBrush}">
                                        <TextBlock.ToolTip><ToolTip MaxWidth="540"><TextBlock Text="{Binding IdentityDetails}" TextWrapping="Wrap" MaxWidth="520" /></ToolTip></TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="GUIDANCE" Width="112" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassificationLabel}" FontFamily="Consolas" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Recommended"><Setter Property="Foreground" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Optional"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Protected"><Setter Property="Foreground" Value="{StaticResource CyanBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="IMPACT" Binding="{Binding ImpactLabel}" Width="75" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="AFTER FLIGHT" Width="115" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="RESTORE" Foreground="{StaticResource GreenBrush}" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DEPENDENCIES" Width="155" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DependencySummary}" FontFamily="Consolas" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDependencyLinks}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.ToolTip><ToolTip MaxWidth="520"><TextBlock Text="{Binding DependencyDetails}" TextWrapping="Wrap" MaxWidth="500" /></ToolTip></TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="WHY THIS GUIDANCE" Width="2.2*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassificationReason}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="520">
                                                    <TextBlock Text="{Binding ClassificationReason}" TextWrapping="Wrap" MaxWidth="500" />
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OPERATIONAL NOTE" Width="2.8*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="520">
                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" MaxWidth="500" />
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="FLIGHT PROFILE">
                <Grid Background="#0C1214" Margin="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Margin="16,16,8,16" Style="{StaticResource PanelFrame}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE PANEL" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,9"/>
                            <TextBlock Text="OPTIMIZATION PROFILE" Style="{StaticResource InstrumentLabel}" Margin="0,3,0,6" />
                            <ComboBox x:Name="ProfileCombo" Height="34" SelectionChanged="ProfileCombo_SelectionChanged" />
                            <CheckBox x:Name="PowerPlanCheck" Content="POWER PLAN / CPU-aware temporary" IsChecked="True"
                                      Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"
                                      ToolTip="Uses Windows Balanced on AMD X3D processors for cache-aware CCD scheduling. Other supported processors use a temporary Ultimate Performance plan. The original plan is restored after the flight." />
                            <TextBlock Text="PROCESS PRIORITY" Style="{StaticResource InstrumentLabel}" Margin="0,11,0,6" />
                            <ComboBox x:Name="PriorityCombo" Height="34" SelectionChanged="ProfileSetting_Changed" />
                            <CheckBox x:Name="CpuSetsCheck" Content="CPU TOPOLOGY / Intel performance-core CPU Sets"
                                      Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"
                                      ToolTip="Uses Windows processor-group-aware CPU Sets on Intel hybrid CPUs only. AMD X3D and existing simulator CPU policies remain scheduler-managed." />
                            <CheckBox x:Name="NvidiaCheck" Content="NVIDIA / temporary persistence" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed" />
                            <CheckBox x:Name="FastLaunchCheck" Content="MSFS 2024 / skip logos + intro (-FastLaunch)" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed" ToolTip="Applies only to Microsoft Flight Simulator 2024 Store and Steam launches." />
                            <CheckBox x:Name="OpenXrTurboCheck" Content="OPENXR / Turbo frame pacing"
                                      Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"
                                      ToolTip="Uses the VR Optimizer's bundled OpenXR layer; OpenXR Toolkit is not required. Temporarily pipelines one frame and removes the layer registration after the session. May conflict with motion reprojection or some runtimes." />
                            <CheckBox x:Name="DashboardEnabledCheck" Content="DASHBOARD MONITORING / FPS when available" IsChecked="True"
                                      Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"
                                      ToolTip="Turns desktop and MSFS VR dashboard monitoring on or off. CPU, MainThread and memory are monitored locally. For MSFS, FPS uses SimConnect when available and a safe PresentMon fallback; FPS can be unavailable while the remaining dashboard monitoring stays active." />
                            <CheckBox x:Name="ContentCreatorCheck" Content="CREATOR MODE / keep capture tools online"
                                      Checked="ContentCreatorCheck_Changed" Unchecked="ContentCreatorCheck_Changed"
                                      ToolTip="Protects OBS, Streamlabs, Twitch Studio, Stream Deck, NVIDIA Broadcast, Voicemeeter, Elgato, XSplit, vMix and related helper services in Automatic mode." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,16,16,16" Style="{StaticResource PanelFrame}" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="SAVED USER PROFILE" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SavedProfileCombo" Height="34" IsEditable="True" SelectionChanged="SavedProfileCombo_Changed" LostKeyboardFocus="SavedProfileCombo_Changed"
                                      primitives:TextBoxBase.TextChanged="SavedProfileCombo_Changed"
                                      ToolTip="Choose an existing profile, or type a new name before selecting Save Current." />
                            <TextBlock x:Name="ProfileStatusText" Margin="0,7,0,0" Text="CURRENT SETTINGS / AUTO-SAVED"
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontWeight="Bold" TextWrapping="Wrap" />
                            <Grid Margin="0,7,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*"/><ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SaveProfileButton" Content="SAVE CHANGES" Click="SaveProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource AccentBrush}" />
                                <Button Grid.Column="2" Content="LOAD" Click="LoadProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource CyanBrush}" />
                                <Button x:Name="RevertProfileButton" Grid.Column="4" Content="REVERT" Click="RevertProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource CyanBrush}" IsEnabled="False" />
                                <Button Grid.Column="6" Content="DELETE" Click="DeleteProfileButton_Click" Padding="5" Background="#3A2424" Foreground="#FFB4AE" BorderBrush="{StaticResource RedBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="DUPLICATE" Click="DuplicateProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource CyanBrush}" />
                                <Button Grid.Column="2" Content="RENAME" Click="RenameProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource CyanBrush}" />
                                <Button Grid.Column="4" Content="EXPORT" Click="ExportProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource GreenBrush}" />
                                <Button Grid.Column="6" Content="IMPORT" Click="ImportProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource GreenBrush}" />
                            </Grid>
                            <TextBlock Text="PROFILE ASSOCIATIONS / OPTIONAL" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="ProfileSimulatorAssociationText" Text="SIMULATOR  /  —" FontFamily="Consolas" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="AIRCRAFT" Style="{StaticResource InstrumentLabel}" Margin="0,8,0,4" />
                            <TextBox x:Name="ProfileAircraftBox" Height="30" Padding="7,4" TextChanged="ProfileAssociation_Changed" ToolTip="Optional aircraft or aircraft family, for example Fenix A320 or GA." />
                            <TextBlock Text="VR HEADSET" Style="{StaticResource InstrumentLabel}" Margin="0,8,0,4" />
                            <TextBox x:Name="ProfileHeadsetBox" Height="30" Padding="7,4" TextChanged="ProfileAssociation_Changed" ToolTip="Optional headset association. The detected runtime headset is suggested when available." />
                            <TextBlock Text="MONITOR CONFIGURATION" Style="{StaticResource InstrumentLabel}" Margin="0,8,0,4" />
                            <TextBox x:Name="ProfileMonitorBox" Height="30" Padding="7,4" TextChanged="ProfileAssociation_Changed" ToolTip="Optional description such as 4K single monitor, triple 1440p, or VR only." />
                            <TextBlock Text="CHANGES FROM SAVED PROFILE" Style="{StaticResource InstrumentLabel}" Margin="0,12,0,6" />
                            <DataGrid x:Name="ProfileDifferencesGrid" Height="150" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0C1214" RowBackground="#0C1214" AlternatingRowBackground="#111A1D"
                                      GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="0.8*" />
                                    <DataGridTextColumn Header="SETTING" Binding="{Binding Setting}" Width="1.3*" />
                                    <DataGridTextColumn Header="SAVED" Binding="{Binding SavedValue}" Width="1.1*" />
                                    <DataGridTextColumn Header="CURRENT" Binding="{Binding CurrentValue}" Width="1.1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="SESSION CONTROL" Style="{StaticResource InstrumentLabel}" Margin="0,13,0,9"/>
                            <TextBlock Text="WORKFLOW MODE" Style="{StaticResource InstrumentLabel}" Margin="0,7,0,6" />
