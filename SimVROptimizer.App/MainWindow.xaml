                                <StackPanel>
                                    <TextBlock Text="SYSTEM DIAGNOSTICS / READ-ONLY CHECKS" Style="{StaticResource InstrumentLabel}" />
                                    <TextBlock x:Name="DiagnosticsStatusText" Text="Select Refresh Diagnostics to check VR and MSFS online readiness."
                                               Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                                    <Button Content="EXPORT SUPPORT PACKAGE" Click="ExportSupportPackageButton_Click"
