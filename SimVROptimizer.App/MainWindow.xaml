                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="DisplayNvidiaProfileText" Text="PROFILE  /  —" Margin="0,7,0,11" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="DisplayGpuText" Text="GPU  /  —" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" />
