                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DisplayFgValueText" Text="—" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="DisplayFgSourceText" Text="—" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Row="5" x:Name="DisplaySrNameText" Text="SUPER RESOLUTION" Margin="0,10,0,0" FontFamily="Consolas" FontWeight="Bold" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DisplaySrValueText" Text="—" Margin="0,10,0,0" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="DisplaySrSourceText" Text="—" Margin="0,10,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Row="6" x:Name="DisplayRrNameText" Text="RAY RECONSTRUCTION" Margin="0,10,0,0" FontFamily="Consolas" FontWeight="Bold" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DisplayRrValueText" Text="—" Margin="0,10,0,0" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="DisplayRrSourceText" Text="—" Margin="0,10,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
