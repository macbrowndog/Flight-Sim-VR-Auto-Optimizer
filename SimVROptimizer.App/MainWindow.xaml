                                            Background="#233137" Foreground="{StaticResource AccentBrush}" IsEnabled="False" />
                                    <Button x:Name="RemoveToolbarPanelButton" Content="REMOVE" Click="RemoveToolbarPanelButton_Click"
                                            Background="#3A2424" Foreground="#FFB4AE" BorderBrush="{StaticResource RedBrush}" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="CUSTOM APPS">
                <ScrollViewer Background="#0C1214" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Background="#111A1D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="COMPANION APP PRELOAD" Style="{StaticResource InstrumentLabel}" />
                                <TextBlock Text="Launch Active Sky, SayIntentions, REX Core Atmos or another companion automatically with the flight session. Companion changes are stored with the selected flight profile when you choose FLIGHT PROFILE → SAVE CHANGES. Apps already running are not duplicated, and only apps started by VR Auto-Optimizer are eligible for automatic cleanup." Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0" />
