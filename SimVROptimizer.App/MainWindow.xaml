<Window x:Class="SimVROptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VR Auto-Optimizer — Flight Deck" Width="1160" Height="820" MinWidth="920" MinHeight="700"
        Icon="Assets/AppIcon.ico" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelFrame}" Padding="14,8" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FLIGHT DECK / VR AUTO-OPTIMIZER" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SESSION CONTROL • PERFORMANCE MANAGEMENT • AUTOMATIC RECOVERY" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="HeaderVersionLabel" Grid.Column="2" Text="ANDREW BROWN © 2026 • VERSION" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CyanBrush}" Margin="18,0,0,0" />
                    </Grid>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0A1012" Padding="14,8" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM READY" Style="{StaticResource InstrumentLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="ACCESS LEVEL" Style="{StaticResource InstrumentLabel}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="AdminLabel" Text="STANDARD USER" Style="{StaticResource ReadoutText}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Padding="10" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Width="160" VerticalAlignment="Center">
                    <TextBlock Text="SIMULATOR SELECT" Style="{StaticResource InstrumentLabel}" />
                    <TextBlock Text="NAV / FLIGHT SOURCE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <ComboBox x:Name="SimulatorCombo" Grid.Column="1" Height="38" Margin="12,0" SelectionChanged="SimulatorCombo_SelectionChanged">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ScanButton" Grid.Column="2" Content="SCAN THIS PC" Click="ScanButton_Click" Background="#233137" Foreground="{StaticResource AccentBrush}" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Background="#090E10" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="SIMULATORS">
                <DataGrid x:Name="SimulatorGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0C1214" Foreground="{StaticResource TextBrush}"
                          RowBackground="#0C1214" AlternatingRowBackground="#111A1D" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SIMULATOR" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="DETECTION SOURCE" Binding="{Binding Detection}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="APPLICATIONS">
                <Grid Background="#0C1214">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#151D20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="APP LOAD CONTROL  /  RECOMMENDED = safe default  ·  OPTIONAL = choose manually  ·  PROTECTED = remains running  ·  UNKNOWN = unchecked" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Border>
                    <DataGrid x:Name="AppsGrid" Grid.Row="1" AutoGenerateColumns="False" Background="#0C1214" Foreground="{StaticResource TextBrush}"
                              RowBackground="#0C1214" AlternatingRowBackground="#111A1D" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUT" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeSelection}" Click="CandidateSelection_Click" HorizontalAlignment="Center" ToolTip="Process Lasso power controllers are locked selected on AMD X3D so Windows Balanced can remain active." /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="APPLICATION" Binding="{Binding DisplayName}" Width="1.4*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="GUIDANCE" Width="112" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassificationLabel}" FontFamily="Consolas" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Recommended"><Setter Property="Foreground" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Optional"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Protected"><Setter Property="Foreground" Value="{StaticResource CyanBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource RedBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="IMPACT" Binding="{Binding Impact}" Width="75" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEM MB" Binding="{Binding MemoryMb}" Width="78" IsReadOnly="True" />
                            <DataGridTextColumn Header="AFTER FLIGHT" Binding="{Binding PostFlightState}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="WHY THIS GUIDANCE" Binding="{Binding ClassificationReason}" Width="2.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="MSFS IMPACT NOTE" Binding="{Binding Reason}" Width="2.8*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="SERVICES">
                <Grid Background="#0C1214">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#151D20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="SERVICE LOAD CONTROL  /  RECOMMENDED = safe default  ·  OPTIONAL = review first  ·  PROTECTED = locked  ·  UNKNOWN = understand dependencies" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Border>
                    <DataGrid x:Name="ServicesGrid" Grid.Row="1" AutoGenerateColumns="False" Background="#0C1214" Foreground="{StaticResource TextBrush}"
                              RowBackground="#0C1214" AlternatingRowBackground="#111A1D" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUT" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStop}" Click="CandidateSelection_Click" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="SERVICE" Binding="{Binding DisplayName}" Width="1.4*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="GUIDANCE" Width="112" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassificationLabel}" FontFamily="Consolas" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Recommended"><Setter Property="Foreground" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Optional"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Protected"><Setter Property="Foreground" Value="{StaticResource CyanBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource RedBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="IMPACT" Binding="{Binding Impact}" Width="75" IsReadOnly="True" />
                            <DataGridTextColumn Header="WHY THIS GUIDANCE" Binding="{Binding ClassificationReason}" Width="2.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="OPERATIONAL NOTE" Binding="{Binding Reason}" Width="2.8*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="FLIGHT PROFILE">
                <Grid Background="#0C1214" Margin="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Margin="16,16,8,16" Style="{StaticResource PanelFrame}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE PANEL" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,9"/>
                            <TextBlock Text="OPTIMIZATION PROFILE" Style="{StaticResource InstrumentLabel}" Margin="0,3,0,6" />
                            <ComboBox x:Name="ProfileCombo" Height="34" SelectionChanged="ProfileCombo_SelectionChanged" />
                            <CheckBox x:Name="PowerPlanCheck" Content="POWER PLAN / CPU-aware temporary" IsChecked="True"
                                      ToolTip="Uses Windows Balanced on AMD X3D processors for cache-aware CCD scheduling. Other supported processors use a temporary Ultimate Performance plan. The original plan is restored after the flight." />
                            <TextBlock Text="PROCESS PRIORITY" Style="{StaticResource InstrumentLabel}" Margin="0,11,0,6" />
                            <ComboBox x:Name="PriorityCombo" Height="34" />
                            <CheckBox x:Name="CpuSetsCheck" Content="CPU TOPOLOGY / Intel performance-core CPU Sets"
                                      ToolTip="Uses Windows processor-group-aware CPU Sets on Intel hybrid CPUs only. AMD X3D and existing simulator CPU policies remain scheduler-managed." />
                            <CheckBox x:Name="NvidiaCheck" Content="NVIDIA / temporary persistence" />
                            <CheckBox x:Name="FastLaunchCheck" Content="MSFS 2024 / skip logos + intro (-FastLaunch)" ToolTip="Applies only to Microsoft Flight Simulator 2024 Store and Steam launches." />
                            <CheckBox x:Name="OpenXrTurboCheck" Content="OPENXR / Turbo frame pacing"
                                      ToolTip="Uses the VR Optimizer's bundled OpenXR layer; OpenXR Toolkit is not required. Temporarily pipelines one frame and removes the layer registration after the session. May conflict with motion reprojection or some runtimes." />
                            <CheckBox x:Name="DashboardEnabledCheck" Content="DASHBOARD SIMCONNECT INFO / monitor session" IsChecked="True"
                                      ToolTip="Turns the desktop and MSFS VR dashboard telemetry feed on or off. When enabled, SimConnect supplies MSFS FPS and frame timing while CPU, MainThread and memory readings are monitored locally." />
                            <CheckBox x:Name="ContentCreatorCheck" Content="CREATOR MODE / keep capture tools online"
                                      Checked="ContentCreatorCheck_Changed" Unchecked="ContentCreatorCheck_Changed"
                                      ToolTip="Protects OBS, Streamlabs, Twitch Studio, Stream Deck, NVIDIA Broadcast, Voicemeeter, Elgato, XSplit, vMix and related helper services in Automatic mode." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,16,16,16" Style="{StaticResource PanelFrame}" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="SAVED USER PROFILE" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SavedProfileCombo" Height="34" IsEditable="True"
                                      ToolTip="Choose an existing profile, or type a new name before selecting Save Current." />
                            <Grid Margin="0,7,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="SAVE CURRENT" Click="SaveProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource AccentBrush}" />
                                <Button Grid.Column="2" Content="LOAD" Click="LoadProfileButton_Click" Padding="5" Background="#233137" Foreground="{StaticResource CyanBrush}" />
                                <Button Grid.Column="4" Content="DELETE" Click="DeleteProfileButton_Click" Padding="5" Background="#3A2424" Foreground="#FFB4AE" BorderBrush="{StaticResource RedBrush}" />
                            </Grid>
                            <TextBlock Text="SESSION CONTROL" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,9"/>
                            <TextBlock Text="WORKFLOW MODE" Style="{StaticResource InstrumentLabel}" Margin="0,7,0,6" />
                            <ComboBox x:Name="ModeCombo" Height="34" SelectionChanged="ModeCombo_SelectionChanged" />
                            <TextBlock x:Name="ModeDescription" Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="VR RUNTIME" Style="{StaticResource InstrumentLabel}" Margin="0,14,0,6" />
                            <ComboBox x:Name="VrRuntimeCombo" Height="34" />
                            <TextBlock Text="LAUNCH TIMEOUT / SEC" Style="{StaticResource InstrumentLabel}" Margin="0,17,0,6" />
                            <TextBox x:Name="TimeoutBox" Text="180" Height="32" Padding="8,5" />
                            <Border Background="#081012" BorderBrush="#2E4448" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                                <TextBlock x:Name="CpuInfoText" TextWrapping="Wrap" Style="{StaticResource ReadoutText}" />
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="ADVANCED">
                <ScrollViewer Background="#0C1214" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelFrame}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="STANDARD / SAFE" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,9"/>
                                <CheckBox x:Name="FlushDnsCheck" Content="DNS FLUSH / one-time cache clear" />
                                <TextBlock Text="CPU-aware power handling, high process priority, vendor-aware CPU sets and NVIDIA persistence are configured on the Flight Profile panel." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Border Background="#081012" BorderBrush="#2E4448" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                                    <TextBlock Text="Service stopping is intentionally excluded from Standard mode. SysMain, Print Spooler, iCloud, Google updater and other approved service candidates are available only under Aggressive." Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelFrame}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="AGGRESSIVE / RESTORED ON EXIT" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,9"/>
                                <CheckBox x:Name="GameDvrCheck" Content="GAME BAR / GAME DVR off temporarily" />
                                <CheckBox x:Name="StandbyMemoryCheck" Content="STANDBY MEMORY / clear once" />
                                <CheckBox x:Name="TimerResolutionCheck" Content="TIMER RESOLUTION / request 0.5 ms" />
                                <CheckBox x:Name="FullscreenOptimizationsCheck" Content="FULLSCREEN OPTIMIZATIONS / disable temporarily" />
                                <CheckBox x:Name="PowerThrottlingCheck" Content="POWER THROTTLING / disable for simulator" />
                                <TextBlock Text="Registry, timer and process settings are restored after the simulator exits. DNS flushing and standby-list clearing are one-time actions and naturally repopulate." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <TextBlock Text="NVIDIA note: persistence mode is supported. Driver-profile ‘Prefer maximum performance’ is not forced because safe restoration requires NVIDIA NVAPI integration." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource PanelFrame}" Padding="16" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MSFS 2024 / VR TOOLBAR DASHBOARD" Style="{StaticResource InstrumentLabel}" Margin="0,0,0,7"/>
                                    <TextBlock x:Name="ToolbarPanelStatusText" Text="Checking toolbar package and telemetry bridge…"
                                               Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ToolbarPanelPathText" Text="COMMUNITY FOLDER / CHECKING"
                                               Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <TextBlock Text="The panel is dashboard-only and designed to be opened or pinned from the MSFS toolbar while flying in VR. It receives read-only performance data over 127.0.0.1; it cannot change optimizer settings, applications, or services."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button x:Name="InstallToolbarPanelButton" Content="INSTALL PANEL" Click="InstallToolbarPanelButton_Click"
                                            Background="#233137" Foreground="{StaticResource AccentBrush}" IsEnabled="False" />
                                    <Button x:Name="RemoveToolbarPanelButton" Content="REMOVE" Click="RemoveToolbarPanelButton_Click"
                                            Background="#3A2424" Foreground="#FFB4AE" BorderBrush="{StaticResource RedBrush}" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="CUSTOM APPS">
                <Grid Background="#0C1214" Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#111A1D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="HOW TO USE CUSTOM APPS" Style="{StaticResource InstrumentLabel}" />
                            <TextBlock Text="Enter a running process name in the left box, one per line (.exe is optional), then select SAVE LISTS + RESCAN. Applications stopped for a flight remain closed during restoration. The saved-path box is retained for compatibility but automatic reopening is disabled." Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1 / APPS TO CLOSE" Style="{StaticResource InstrumentLabel}" />
                            <TextBlock Text="Process name only. Find it in Task Manager → Details." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,7" />
                            <Grid>
                                <TextBox x:Name="CustomKillBox" Height="300" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="9" TextWrapping="NoWrap"
                                         ToolTip="Enter one process name per line. You may include or omit .exe." />
                                <TextBlock IsHitTestVisible="False" Margin="10" FontFamily="Consolas" Foreground="#60706D" TextWrapping="Wrap"
                                           Text="EXAMPLE — not saved&#x0a;&#x0a;CCleaner64&#x0a;OneDrive">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CustomKillBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="2 / SAVED PATH (REOPENING DISABLED)" Style="{StaticResource InstrumentLabel}" />
                            <TextBlock Text="Kept for compatibility. Apps now remain closed after restoration." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,7" />
                            <Grid>
                                <TextBox x:Name="CustomRestartBox" Height="300" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="9" TextWrapping="NoWrap"
                                         IsReadOnly="True" IsEnabled="False" ToolTip="Automatic application reopening is disabled. Applications remain closed after the flight." />
                                <TextBlock IsHitTestVisible="False" Margin="10" FontFamily="Consolas" Foreground="#60706D" TextWrapping="Wrap"
                                           Text="EXAMPLE — not saved&#x0a;&#x0a;CCleaner64=C:\Program Files\CCleaner\CCleaner64.exe&#x0a;&#x0a;OneDrive=%LOCALAPPDATA%\Microsoft\OneDrive\OneDrive.exe">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CustomRestartBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="SaveCustomButton" Content="SAVE LISTS + RESCAN" Click="SaveCustomButton_Click" Background="#233137" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="DashboardTab" Header="DASHBOARD">
                <ScrollViewer x:Name="DashboardScroll" Background="#0C1214" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource PanelFrame}" Padding="9" Margin="0,0,0,7">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="LIVE PERFORMANCE / SIMULATOR PROCESS" Style="{StaticResource InstrumentLabel}" />
                                    <TextBlock x:Name="DashboardStatusText" Text="STANDBY — monitoring starts when the simulator process is detected." Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox x:Name="DashboardCsvCheck" Content="SAVE CSV" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="7" Margin="0,0,0,7">
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6" Margin="0,0,6,0"><StackPanel><TextBlock Text="FPS" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashFps" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource GreenBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6" Margin="0,0,6,0"><StackPanel><TextBlock Text="AVERAGE" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashAverageFps" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource CyanBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6" Margin="0,0,6,0"><StackPanel><TextBlock Text="1% LOW" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashOneLow" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6" Margin="0,0,6,0"><StackPanel><TextBlock Text="FRAME MS" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashFrameTime" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource CyanBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6" Margin="0,0,6,0"><StackPanel><TextBlock Text="SIM CPU" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashProcessCpu" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6" Margin="0,0,6,0"><StackPanel><TextBlock Text="MAIN THREAD" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashMainThread" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource CyanBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelFrame}" Padding="8,6"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashMemory" Text="—" FontFamily="Consolas" FontSize="21" Foreground="{StaticResource CyanBrush}"/></StackPanel></Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelFrame}" Padding="8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7" LastChildFill="False"><TextBlock Text="FPS / LAST 60 SECONDS" DockPanel.Dock="Left" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashFpsScale" DockPanel.Dock="Right" Text="0–120" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas"/></DockPanel>
                                    <Canvas x:Name="FpsGraph" Height="105" Background="#05090A" SizeChanged="DashboardGraph_SizeChanged">
                                        <Polyline x:Name="FpsGraphLine" Stroke="{StaticResource GreenBrush}" StrokeThickness="2" />
                                    </Canvas>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelFrame}" Padding="8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7" LastChildFill="False"><TextBlock Text="CPU LOAD / LAST 60 SECONDS" DockPanel.Dock="Left" Style="{StaticResource InstrumentLabel}"/><TextBlock Text="0–100%" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas"/></DockPanel>
                                    <Canvas x:Name="CpuGraph" Height="105" Background="#05090A" SizeChanged="DashboardGraph_SizeChanged">
                                        <Polyline x:Name="SystemCpuGraphLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                        <Polyline x:Name="ProcessCpuGraphLine" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" />
                                    </Canvas>
                                    <TextBlock Text="AMBER system CPU  /  CYAN simulator CPU" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource PanelFrame}" Padding="8" Margin="0,7,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False"><TextBlock Text="PROCESSOR LOAD SUMMARY" DockPanel.Dock="Left" Style="{StaticResource InstrumentLabel}"/><TextBlock x:Name="DashSystemCpu" DockPanel.Dock="Right" Text="SYSTEM CPU —" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/></DockPanel>
                                <TextBlock x:Name="DashCpuName" Text="CPU —" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,5,0,0" />
                                <TextBlock x:Name="DashCoreText" Text="Waiting for CPU samples…" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelFrame}" Padding="8" Margin="0,0,4,0">
                                <DockPanel LastChildFill="True">
                                    <Button Content="RESET STUTTERS" DockPanel.Dock="Right" Click="ResetDashboardStuttersButton_Click"
                                            Padding="12,5" Margin="12,0,0,0" Background="#17140D"
                                            BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="DashboardStutterText" Text="FRAME-TIME STUTTERS: 0" Foreground="{StaticResource GreenBrush}"
                                               FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelFrame}" Padding="8" Margin="4,0,0,0">
                                <DockPanel LastChildFill="True">
                                    <Button Content="RESET SPIKES" DockPanel.Dock="Right" Click="ResetDashboardCpuSpikesButton_Click"
                                            Padding="12,5" Margin="12,0,0,0" Background="#17140D"
                                            BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="DashboardCpuSpikeText" Text="CPU SPIKE SAMPLES: 0" Foreground="{StaticResource GreenBrush}"
                                               FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="FLIGHT LOG">
                <Grid Background="#080D0F" Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="SESSION EVENT RECORDER" Style="{StaticResource InstrumentLabel}" />
                        <TextBlock Text="LIVE" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource RedBrush}" FontFamily="Consolas" FontWeight="Bold" />
                    </DockPanel>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="#05090A" Foreground="{StaticResource CyanBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{StaticResource PanelFrame}" Padding="10,6" Margin="0,7,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <UniformGrid Columns="5">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="Stage1Lamp" Width="8" Height="8" Fill="{StaticResource BorderBrush}" Margin="0,0,7,0"/><TextBlock x:Name="Stage1Label" Text="01 PREPARE" Style="{StaticResource InstrumentLabel}"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="Stage2Lamp" Width="8" Height="8" Fill="{StaticResource BorderBrush}" Margin="0,0,7,0"/><TextBlock x:Name="Stage2Label" Text="02 OPTIMIZE" Style="{StaticResource InstrumentLabel}"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="Stage3Lamp" Width="8" Height="8" Fill="{StaticResource BorderBrush}" Margin="0,0,7,0"/><TextBlock x:Name="Stage3Label" Text="03 VR RUNTIME" Style="{StaticResource InstrumentLabel}"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="Stage4Lamp" Width="8" Height="8" Fill="{StaticResource BorderBrush}" Margin="0,0,7,0"/><TextBlock x:Name="Stage4Label" Text="04 SIMULATOR" Style="{StaticResource InstrumentLabel}"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="Stage5Lamp" Width="8" Height="8" Fill="{StaticResource BorderBrush}" Margin="0,0,7,0"/><TextBlock x:Name="Stage5Label" Text="05 RESTORE" Style="{StaticResource InstrumentLabel}"/></StackPanel>
                </UniformGrid>
                <TextBlock x:Name="PipelineDetail" Grid.Row="1" Text="PIPELINE STANDBY" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PanelFrame}" Padding="10,6" Margin="0,7,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateLamp" Width="11" Height="11" Fill="{StaticResource GreenBrush}" Margin="0,0,9,0"/>
                    <TextBlock Text="SYSTEM STATUS /" Style="{StaticResource InstrumentLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StateLabel" Text="READY" Style="{StaticResource ReadoutText}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ReportButton" Content="LAST REPORT" Click="ReportButton_Click" Background="#233137" Foreground="{StaticResource CyanBrush}" IsEnabled="False" />
                    <Button x:Name="RestoreButton" Content="RESTORE" Click="RestoreButton_Click" Background="#5A461D" Foreground="{StaticResource AccentBrush}" IsEnabled="False" />
                    <Button x:Name="CancelButton" Content="ABORT / RESTORE" Click="CancelButton_Click" Background="#4D2425" BorderBrush="{StaticResource RedBrush}" Foreground="#FFB4AE" IsEnabled="False" />
                    <Button x:Name="StartButton" Content="START FLIGHT SESSION" Click="StartButton_Click" Background="{StaticResource AccentBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
