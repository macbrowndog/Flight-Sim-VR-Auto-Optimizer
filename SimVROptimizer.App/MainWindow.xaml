                        <Border Style="{StaticResource PanelFrame}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="IN-SIMULATOR DLSS INFORMATION" Style="{StaticResource InstrumentLabel}" />
                                    <TextBlock x:Name="DisplayDlssIndicatorStatusText" Text="Reading NVIDIA overlay state…"
                                               Margin="0,7,18,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
