                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Health}" Value="{x:Static core:DiagnosticHealth.Ready}">
                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Health}" Value="{x:Static core:DiagnosticHealth.Review}">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Health}" Value="{x:Static core:DiagnosticHealth.Problem}">
                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="2*" />
