                                    <TextBlock x:Name="DisplayRecommendationEvidenceText" Text="EVIDENCE  /  —" Margin="0,7,18,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DisplayRecommendationSafetyText" Text="Recommendations only — VR Auto-Optimizer does not rewrite UserCfg.opt."
                                               Margin="0,8,18,0" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BackupUserCfgButton" Grid.Column="1" Content="BACK UP USERCFG.OPT" Click="BackupUserCfgButton_Click" IsEnabled="False"
