                        <Border Style="{StaticResource PanelFrame}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="VERSION / SOURCE" Style="{StaticResource InstrumentLabel}" />
                                <TextBlock x:Name="DisplayDlssVersionText" Text="LOADED DLSS LIBRARY  /  —" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="DisplayConfigVersionText" Text="USERCFG VERSION  /  —" Margin="0,7,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="DisplayConfigPathText" Text="USERCFG.OPT  /  —" Margin="0,7,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DisplayNvidiaStatusText" Margin="0,9,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="MSFS mode is read from UserCfg.opt. NVIDIA override values are read from the active driver profile. This page is read-only."
