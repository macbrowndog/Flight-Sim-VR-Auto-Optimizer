                                                Padding="11,6" Margin="0" Background="#233137" Foreground="{StaticResource GreenBrush}"
                                                ToolTip="Opens the official Microsoft Flight Simulator Online Services Monitoring page." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
