                                  GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                <DataGridCheckBoxColumn Header="ADMIN" Binding="{Binding RunAsAdministrator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                                <DataGridCheckBoxColumn Header="MINIMIZE" Binding="{Binding MinimizeAfterLaunch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="78" />
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                <DataGridTextColumn Header="EXECUTABLE" Binding="{Binding ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2.2*" />
                                <DataGridTemplateColumn Header="START" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableLaunchTimings}" SelectedItem="{Binding SelectedLaunchTiming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="CompanionOption_SelectionChanged" Padding="6,2" MinHeight="25" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="LAUNCH DELAY / SEC" Binding="{Binding LaunchDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="125" />
                                <DataGridTemplateColumn Header="AFTER FLIGHT" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableCleanupActions}" SelectedItem="{Binding SelectedCleanupAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="CompanionOption_SelectionChanged" Padding="6,2" MinHeight="25" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,9,0,16" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                                <Button x:Name="AddCompanionAppButton" Content="SELECT APP / EXE" Click="AddCompanionAppButton_Click" Background="#233137" Foreground="{StaticResource GreenBrush}" />
                                <Button x:Name="RemoveCompanionAppButton" Content="REMOVE" Click="RemoveCompanionAppButton_Click" Background="#3A2424" Foreground="#FFB4AE" BorderBrush="{StaticResource RedBrush}" />
                            </StackPanel>
                            <TextBlock Text="MINIMIZE waits for the launched app's normal window and minimizes it. Launch delay is applied after the selected trigger and before starting that app (0–300 seconds). READY TO FLY uses MSFS SimConnect FlightLoaded with a bounded fallback. CLOSE ON SESSION END first requests a normal app exit."
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="APPS TO CLOSE DURING THE FLIGHT" Style="{StaticResource InstrumentLabel}" />
                        <TextBlock Text="Enter a running process name, one per line (.exe is optional). These are separate from companion apps launched above." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,7" />
                        <TextBox x:Name="CustomKillBox" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="9" TextWrapping="NoWrap" TextChanged="ProfileSetting_Changed"
                                 ToolTip="Enter one process name per line. You may include or omit .exe." />
                        <TextBox x:Name="CustomRestartBox" Height="0" Visibility="Collapsed" IsReadOnly="True" IsEnabled="False" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="SaveCustomButton" Content="SAVE CLOSE LIST + RESCAN" Click="SaveCustomButton_Click" Background="#233137" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
