                                <StackPanel>
                                    <TextBlock Text="VR RUNTIME DIAGNOSTICS / OPENXR HEALTH" Style="{StaticResource InstrumentLabel}" />
                                    <TextBlock x:Name="VrHealthSummaryText" Text="NOT CHECKED" Margin="0,8,0,0" FontFamily="Consolas" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VrSelectedRuntimeText" Text="AUTO-LAUNCH RUNTIME  /  —" Margin="0,9,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VrRuntimeAvailabilityText" Text="LAUNCHER STATUS  /  —" Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VrRuntimeAlignmentText" Text="RUNTIME ALIGNMENT  /  —" Margin="0,6,0,0" FontFamily="Consolas" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VrRuntimeNameText" Text="ACTIVE RUNTIME  /  —" Margin="0,9,0,0" FontFamily="Consolas" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VrHeadsetText" Text="HEADSET  /  —" Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VrInstalledRuntimesText" Text="AVAILABLE LAUNCHERS  /  —" Margin="0,6,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelFrame}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="MSFS ONLINE SERVICES HEALTH" Style="{StaticResource InstrumentLabel}" />
                                    <TextBlock x:Name="OnlineHealthSummaryText" Text="NOT CHECKED" Margin="0,8,0,8" FontFamily="Consolas" FontWeight="Bold" TextWrapping="Wrap" />
