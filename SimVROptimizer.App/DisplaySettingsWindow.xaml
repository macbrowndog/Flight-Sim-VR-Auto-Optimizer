<Window x:Class="SimVROptimizer.App.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSFS Display &amp; NVIDIA DLSS Settings" Width="760" Height="590" MinWidth="680" MinHeight="540"
        Icon="Assets/AppIcon.ico" Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="MSFS / DISPLAY SETTINGS" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="ConfigVersionText" Margin="0,5,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelFrame}" Padding="16">
                <StackPanel>
                    <TextBlock Text="2D DISPLAY" Style="{StaticResource InstrumentLabel}" />
                    <TextBlock x:Name="DesktopRenderingText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                    <TextBlock x:Name="DesktopDlssText" Margin="0,9,0,0" FontFamily="Consolas" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelFrame}" Padding="16">
                <StackPanel>
                    <TextBlock Text="VR DISPLAY" Style="{StaticResource InstrumentLabel}" />
                    <TextBlock x:Name="VrRenderingText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                    <TextBlock x:Name="VrDlssText" Margin="0,9,0,0" FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelFrame}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="NVIDIA APP / DLSS OVERRIDE – MODEL PRESETS" Style="{StaticResource InstrumentLabel}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="NvidiaProfileText" Margin="0,7,0,9" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Row="2" x:Name="FgNameText" FontFamily="Consolas" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FgValueText" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="FgSourceText" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Row="3" x:Name="SrNameText" Margin="0,8,0,0" FontFamily="Consolas" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SrValueText" Margin="0,8,0,0" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}" />
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SrSourceText" Margin="0,8,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Row="4" x:Name="RrNameText" Margin="0,8,0,0" FontFamily="Consolas" FontWeight="Bold" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RrValueText" Margin="0,8,0,0" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}" />
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="RrSourceText" Margin="0,8,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource PanelFrame}" Padding="12">
            <StackPanel>
                <TextBlock Text="VERSION / SOURCE" Style="{StaticResource InstrumentLabel}" />
                <TextBlock x:Name="DlssVersionText" Margin="0,7,0,0" FontFamily="Consolas" />
                <TextBlock x:Name="ConfigPathText" Margin="0,7,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="NvidiaStatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="MSFS mode comes from UserCfg.opt. NVIDIA override values are read from the active driver profile and are not changed by this dialog." Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Button Grid.Row="4" Content="CLOSE" Click="Close_Click" HorizontalAlignment="Right" Margin="0,14,0,0" Background="{StaticResource AccentBrush}" />
    </Grid>
</Window>
